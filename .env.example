# Ruta del archivo SQLite. Por omisión: ./data/docucalidad.db
SACD_DB_PATH=./data/docucalidad.db

# Directorio de los archivos cargados. Por omisión: ./data/uploads
SACD_UPLOAD_DIR=./data/uploads

# Credencial de la API de Anthropic. Sin ella el motor de analisis (etapa 4) no
# esta disponible y solo puede usarse el motor provisional.
ANTHROPIC_API_KEY=

# Modelo del motor de analisis. Por omision: claude-opus-5
SACD_MODELO=claude-opus-5

# Tope de tokens de entrada por evaluacion. Por encima se rechaza en lugar de
# truncar el documento en silencio. Por omision: 400000
SACD_MAX_TOKENS_ENTRADA=400000
