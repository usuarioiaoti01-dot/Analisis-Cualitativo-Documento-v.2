# Ruta del archivo SQLite. Por omisión: ./data/docucalidad.db
SACD_DB_PATH=./data/docucalidad.db

# Directorio de los archivos cargados. Por omisión: ./data/uploads
SACD_UPLOAD_DIR=./data/uploads

# Credencial de la API de Anthropic. Sin ella el motor de analisis (etapa 4) no
# esta disponible y solo puede usarse el motor provisional.
ANTHROPIC_API_KEY=

# Modelo del motor de analisis y de la transcripcion de escaneos.
# Por omision: claude-opus-5
# Alternativa mas economica: claude-sonnet-5
SACD_MODELO=claude-opus-5

# Tope de tokens de entrada por evaluacion. Por encima se rechaza en lugar de
# truncar el documento en silencio. Por omision: 400000
SACD_MAX_TOKENS_ENTRADA=400000

# ── Enlace con el Inventario Normativo del SERFOR ───────────────────────────
# github.com/usuarioiaoti01-dot/Inventario-Normativo-SERFOR
#
# Sus politicas de acceso exigen sesion iniciada, asi que la clave publica no
# basta. Se inicia sesion con una cuenta del propio inventario: conviene que
# sea de SOLO LECTURA. No se usa la clave service_role, que salta todas las
# reglas de acceso.
SACD_INVENTARIO_USUARIO=
SACD_INVENTARIO_CLAVE=

# Opcionales: solo si el proyecto o las tablas cambian.
# SACD_INVENTARIO_URL=https://armvuvoluoxspfjpefex.supabase.co
# SACD_INVENTARIO_ANON_KEY=
# SACD_INVENTARIO_TABLAS=documentos,normativos_opr
# SACD_INVENTARIO_BUCKET=documentos
